{
  "name": "encfs-tree-browser",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:std && npm run build:standalone && npm run copy:agent",
    "build:std": "tsc -b && vite build",
    "build:standalone": "tsc -b && vite build --mode standalone",
    "build:agent": "npm run build:standalone && cargo build --release --manifest-path encfs-browser-agent/Cargo.toml && node encfs-browser-agent/compress.mjs && npm run copy:agent",
    "copy:agent": "node encfs-browser-agent/copy.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "encfs-filename-codec": "file:../encfs-names-ts",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@prefresh/vite": "^4.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/ui": "^4.1.11",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  }
}
